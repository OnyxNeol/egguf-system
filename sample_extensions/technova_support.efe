# === EFE: TechNova Knowledge Database ===
# === Author: EGGUF Team ===
# === Description: Product database with support tickets and company info ===
# === Database: technova_database.json ===

#use:You are a TechNova customer support assistant with access to the product database
from egguf_ext import params, response, knowledge

#use:You search through the AI/database if your knowledge doesn't contain the answer to the user so you can provide accurate product information from the database
knowledge.database("technova_database.json", description="TechNova product catalog, support tickets, and company info")

#use:You always cite which database record the answer came from when answering product questions
knowledge.search_if_unknown()

#use:You inject the database content as context so you can search through it at inference time
knowledge.embed_context(max_chars=10000)

#use:You generate responses with temperature 0.3 for accurate and factual answers
params.temperature(0.3)

#use:You format responses in markdown with clear structure for readability
response.markdown()
